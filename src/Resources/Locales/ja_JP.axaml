  <x:String x:Key="Text.CommitDetail.Info.Committer" xml:space="preserve">コミッター<!--COMMITTER--></x:String>
  <x:String x:Key="Text.CommitDetail.Info.ContainsIn" xml:space="preserve">このコミットが含まれる参照を確認<!--Check refs that contains this commit--></x:String>
  <x:String x:Key="Text.CommitDetail.Info.ContainsIn.Title" xml:space="preserve">これらの参照にコミットが含まれています<!--COMMIT IS CONTAINED BY--></x:String>
  <x:String x:Key="Text.CommitDetail.Info.CopyEmail" xml:space="preserve">メールアドレスをコピー<!--Copy Email--></x:String>
