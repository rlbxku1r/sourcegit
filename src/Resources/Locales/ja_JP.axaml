  <x:String x:Key="Text.Configure.Git" xml:space="preserve">Git<!--GIT--></x:String>
  <x:String x:Key="Text.Configure.Git.AskBeforeAutoUpdatingSubmodules" xml:space="preserve">サブモジュールを自動更新する前に尋ねる<!--Ask before auto-updating submodules--></x:String>
