  <x:String x:Key="Text.About" xml:space="preserve">情報<!--About--></x:String>
  <x:String x:Key="Text.About.Menu" xml:space="preserve">SourceGit について<!--About SourceGit--></x:String>
  <x:String x:Key="Text.About.ReleaseDate" xml:space="preserve">リリース日: {0}<!--Release Date: {0}--></x:String>
  <x:String x:Key="Text.About.ReleaseNotes" xml:space="preserve">リリースノート<!--Release Notes--></x:String>
  <x:String x:Key="Text.About.SubTitle" xml:space="preserve">オープンソース &amp; フリーな Git GUI クライアント<!--Opensource & Free Git GUI Client--></x:String>
  <x:String x:Key="Text.AddToIgnore" xml:space="preserve">ファイルの変更を無視<!--Add File(s) To Ignore--></x:String>
  <x:String x:Key="Text.AddToIgnore.Pattern" xml:space="preserve">パターン:<!--Pattern:--></x:String>
  <x:String x:Key="Text.AddToIgnore.Storage" xml:space="preserve">登録先のファイル:<!--Storage File:--></x:String>
  <x:String x:Key="Text.AddWorktree" xml:space="preserve">作業ツリーを追加<!--Add Worktree--></x:String>
  <x:String x:Key="Text.AddWorktree.Location" xml:space="preserve">場所:<!--Location:--></x:String>
  <x:String x:Key="Text.AddWorktree.Location.Placeholder" xml:space="preserve">この作業ツリーへのパス (相対パスも使用できます)<!--Path for this worktree. Relative path is supported.--></x:String>
  <x:String x:Key="Text.AddWorktree.Name" xml:space="preserve">ブランチの名前:<!--Branch Name:--></x:String>
  <x:String x:Key="Text.AddWorktree.Name.Placeholder" xml:space="preserve">省略可能 - 既定では宛先のフォルダーと同じ名前が使用されます<!--Optional. Default is the destination folder name.--></x:String>
  <x:String x:Key="Text.AddWorktree.Tracking" xml:space="preserve">追跡するブランチ:<!--Track Branch:--></x:String>
  <x:String x:Key="Text.AddWorktree.Tracking.Toggle" xml:space="preserve">追跡するリモートブランチを設定<!--Tracking remote branch--></x:String>
  <x:String x:Key="Text.AddWorktree.WhatToCheckout" xml:space="preserve">チェックアウトする内容:<!--What to Checkout:--></x:String>
  <x:String x:Key="Text.AddWorktree.WhatToCheckout.CreateNew" xml:space="preserve">新しいブランチを作成<!--Create New Branch--></x:String>
  <x:String x:Key="Text.AddWorktree.WhatToCheckout.Existing" xml:space="preserve">既存のブランチ<!--Existing Branch--></x:String>
  <x:String x:Key="Text.AIAssistant" xml:space="preserve">AI アシスタント<!--AI Assistant--></x:String>
  <x:String x:Key="Text.AIAssistant.Model" xml:space="preserve">モデル<!--MODEL--></x:String>
  <x:String x:Key="Text.AIAssistant.Regen" xml:space="preserve">再生成<!--RE-GENERATE--></x:String>
  <x:String x:Key="Text.AIAssistant.Tip" xml:space="preserve">AI を使用してコミットメッセージを生成<!--Use AI to generate commit message--></x:String>
  <x:String x:Key="Text.AIAssistant.Use" xml:space="preserve">使用<!--Use--></x:String>
  <x:String x:Key="Text.App.Hide" xml:space="preserve">SourceGit を隠す<!--Hide SourceGit--></x:String>
  <x:String x:Key="Text.App.HideOthers" xml:space="preserve">他を隠す<!--Hide Others--></x:String>
  <x:String x:Key="Text.App.ShowAll" xml:space="preserve">すべて表示<!--Show All--></x:String>
  <x:String x:Key="Text.Apply.3Way" xml:space="preserve">3 分割マージ<!--3-Way Merge--></x:String>
  <x:String x:Key="Text.Apply.File.Placeholder" xml:space="preserve">適用する .patch ファイルを選択<!--Select .patch file to apply--></x:String>
  <x:String x:Key="Text.Apply.IgnoreWS" xml:space="preserve">空白文字の変更を無視<!--Ignore whitespace changes--></x:String>
  <x:String x:Key="Text.Apply.Source" xml:space="preserve">適用元:<!--Source:--></x:String>
  <x:String x:Key="Text.Apply.Source.File" xml:space="preserve">ファイル<!--File--></x:String>
  <x:String x:Key="Text.Apply.Source.Clipboard" xml:space="preserve">クリップボード<!--Clipboard--></x:String>
  <x:String x:Key="Text.Apply.Title" xml:space="preserve">パッチを適用<!--Apply Patch--></x:String>
  <x:String x:Key="Text.Apply.WS" xml:space="preserve">空白文字:<!--Whitespace:--></x:String>
  <x:String x:Key="Text.ApplyStash" xml:space="preserve">スタッシュを適用<!--Apply Stash--></x:String>
  <x:String x:Key="Text.ApplyStash.DropAfterApply" xml:space="preserve">適用後に削除<!--Delete after applying--></x:String>
  <x:String x:Key="Text.ApplyStash.RestoreIndex" xml:space="preserve">インデックスの変更を復元<!--Reinstate the index's changes--></x:String>
  <x:String x:Key="Text.ApplyStash.Stash" xml:space="preserve">スタッシュ:<!--Stash:--></x:String>
  <x:String x:Key="Text.Archive" xml:space="preserve">アーカイブ化...<!--Archive...--></x:String>
  <x:String x:Key="Text.Archive.File" xml:space="preserve">アーカイブの保存先:<!--Save Archive To:--></x:String>
  <x:String x:Key="Text.Archive.File.Placeholder" xml:space="preserve">アーカイブファイルへのパスを選択<!--Select archive file path--></x:String>
  <x:String x:Key="Text.Archive.Revision" xml:space="preserve">リビジョン:<!--Revision:--></x:String>
  <x:String x:Key="Text.Archive.Title" xml:space="preserve">アーカイブ化<!--Archive--></x:String>
  <x:String x:Key="Text.Askpass" xml:space="preserve">SourceGit Askpass<!--SourceGit Askpass--></x:String>
  <x:String x:Key="Text.Askpass.Passphrase" xml:space="preserve">パスフレーズを入力:<!--Enter passphrase:--></x:String>
  <x:String x:Key="Text.AssumeUnchanged" xml:space="preserve">未変更と見なしたファイル<!--FILES ASSUME UNCHANGED--></x:String>
  <x:String x:Key="Text.AssumeUnchanged.Empty" xml:space="preserve">未変更と見なしたファイルはありません<!--NO FILES ASSUMED AS UNCHANGED--></x:String>
  <x:String x:Key="Text.Avatar.Load" xml:space="preserve">画像を選択...<!--Load Image...--></x:String>
  <x:String x:Key="Text.Avatar.Refetch" xml:space="preserve">再読み込み<!--Refresh--></x:String>
  <x:String x:Key="Text.Bisect">問題の発生源を特定<!--Bisect--></x:String>
  <x:String x:Key="Text.Bisect.Abort">中止<!--Abort--></x:String>
  <x:String x:Key="Text.Bisect.Bad">問題あり<!--Bad--></x:String>
  <x:String x:Key="Text.Bisect.Good">問題なし<!--Good--></x:String>
  <x:String x:Key="Text.Bisect.Skip">スキップ<!--Skip--></x:String>
  <x:String x:Key="Text.Bisect.WaitingForCheckoutAnother">問題の発生源となったコミットを特定しています。別のコミットをチェックアウトし、そのコミットに問題があるかどうかを調査してください。<!--Bisecting. Please checkout another one then mark it as good or bad.--></x:String>
  <x:String x:Key="Text.Bisect.WaitingForFirstBad">問題の発生源となったコミットを特定しています。問題があるコミットをチェックアウト・選択してください。<!--Bisecting. Mark current commit as bad or checkout another one then mark it as bad.--></x:String>
  <x:String x:Key="Text.Bisect.WaitingForFirstGood">問題の発生源となったコミットを特定しています。現在のコミットに問題があるかどうかを調査したあと、別のコミットをチェックアウトしてみてください。<!--Bisecting. Mark current commit as good or bad and checkout another one.--></x:String>
  <x:String x:Key="Text.Bisect.WaitingForMark">問題の発生源となったコミットを特定しています。現在の HEAD に問題はありませんか？<!--Bisecting. Is current HEAD good or bad?--></x:String>
  <x:String x:Key="Text.Blame" xml:space="preserve">著者の履歴<!--Blame--></x:String>
  <x:String x:Key="Text.Blame.BlameOnPreviousRevision" xml:space="preserve">前のリビジョンの著者の履歴<!--Blame on Previous Revision--></x:String>
  <x:String x:Key="Text.Blame.IgnoreWhitespace">空白文字の変更を無視<!--Ignore whitespace changes--></x:String>
  <x:String x:Key="Text.Blame.TypeNotSupported" xml:space="preserve">このファイルに著者の履歴は表示できません！！！<!--BLAME ON THIS FILE IS NOT SUPPORTED!!!--></x:String>
  <x:String x:Key="Text.BranchCM.Checkout" xml:space="preserve">${0}$ をチェックアウト...<!--Checkout ${0}$...--></x:String>
