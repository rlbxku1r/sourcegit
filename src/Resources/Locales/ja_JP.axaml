  <x:String x:Key="Text.CommitMessageTextBox.Column" xml:space="preserve">列<!--COL--></x:String>
  <x:String x:Key="Text.CommitMessageTextBox.Placeholder" xml:space="preserve">コミットメッセージを入力してください。タイトルと説明は、空行で分けて記述してください！<!--Enter commit message. Please use an empty-line to separate subject and description!--></x:String>
