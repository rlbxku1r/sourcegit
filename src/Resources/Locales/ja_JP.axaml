  <x:String x:Key="Text.BranchCM.CompareWithSpecial" xml:space="preserve">${0}$ と比較<!--Compare with ${0}$--></x:String>
  <x:String x:Key="Text.BranchCM.CopyName" xml:space="preserve">ブランチ名をコピー<!--Copy Branch Name--></x:String>
  <x:String x:Key="Text.BranchCM.CreatePR" xml:space="preserve">プルリクエストを作成...<!--Create PR...--></x:String>
  <x:String x:Key="Text.BranchCM.CreatePRForUpstream" xml:space="preserve">上流の ${0}$ にプルリクエストを作成...<!--Create PR for upstream ${0}$...--></x:String>
  <x:String x:Key="Text.BranchCM.CustomAction" xml:space="preserve">カスタムアクション<!--Custom Action--></x:String>
  <x:String x:Key="Text.BranchCM.Delete" xml:space="preserve">${0}$ を削除...<!--Delete ${0}$...--></x:String>
  <x:String x:Key="Text.BranchCM.DeleteMultiBranches" xml:space="preserve">選択した {0} 個のブランチを削除...<!--Delete selected {0} branches...--></x:String>
  <x:String x:Key="Text.BranchCM.EditDescription" xml:space="preserve">${0}$ の説明を編集...<!--Edit description for ${0}$...--></x:String>
  <x:String x:Key="Text.BranchCM.FastForward" xml:space="preserve">${0}$ まで早送り<!--Fast-Forward to ${0}$--></x:String>
  <x:String x:Key="Text.BranchCM.FetchInto" xml:space="preserve">${0}$ から ${1}$ にフェッチ<!--Fetch ${0}$ into ${1}$--></x:String>
  <x:String x:Key="Text.BranchCM.Finish" xml:space="preserve">Git フロー - ${0}$ を完了...<!--Git Flow - Finish ${0}$...--></x:String>
  <x:String x:Key="Text.BranchCM.InteractiveRebase.Manually" xml:space="preserve">${0}$ を ${1}$ で対話式リベース<!--Interactively Rebase ${0}$ on ${1}$--></x:String>
  <x:String x:Key="Text.BranchCM.Merge" xml:space="preserve">${0}$ を ${1}$ にマージ...<!--Merge ${0}$ into ${1}$...--></x:String>
  <x:String x:Key="Text.BranchCM.MergeMultiBranches" xml:space="preserve">現在のブランチに、選択した {0} 個のブランチをマージ...<!--Merge selected {0} branches into current...--></x:String>
  <x:String x:Key="Text.BranchCM.Pull" xml:space="preserve">${0}$ からプル...<!--Pull ${0}$...--></x:String>
  <x:String x:Key="Text.BranchCM.PullInto" xml:space="preserve">${0}$ から ${1}$ にプル...<!--Pull ${0}$ into ${1}$...--></x:String>
  <x:String x:Key="Text.BranchCM.Push" xml:space="preserve">${0}$ をプッシュ...<!--Push ${0}$...--></x:String>
  <x:String x:Key="Text.BranchCM.Rebase" xml:space="preserve">${0}$ を ${1}$ でリベース...<!--Rebase ${0}$ on ${1}$...--></x:String>
  <x:String x:Key="Text.BranchCM.Rename" xml:space="preserve">${0}$ の名前を変更...<!--Rename ${0}$...--></x:String>
  <x:String x:Key="Text.BranchCM.ResetToSelectedCommit" xml:space="preserve">${0}$ を ${1}$ にリセット...<!--Reset ${0}$ to ${1}$...--></x:String>
  <x:String x:Key="Text.BranchCM.SwitchToWorktree" xml:space="preserve">${0}$ に切り替え (作業ツリー)<!--Switch to ${0}$ (worktree)--></x:String>
  <x:String x:Key="Text.BranchCM.Tracking" xml:space="preserve">追跡するブランチを設定...<!--Set Tracking Branch...--></x:String>
  <x:String x:Key="Text.BranchTree.Ahead" xml:space="preserve">ローカルに {0} コミット済み<!--{0} commit(s) ahead--></x:String>
  <x:String x:Key="Text.BranchTree.AheadBehind" xml:space="preserve">ローカルに {0} コミット済み、リモートに {1} コミットあり<!--{0} commit(s) ahead, {1} commit(s) behind--></x:String>
  <x:String x:Key="Text.BranchTree.Behind" xml:space="preserve">リモートに {0} コミットあり<!--{0} commit(s) behind--></x:String>
  <x:String x:Key="Text.BranchTree.InvalidUpstream" xml:space="preserve">無効<!--Invalid--></x:String>
  <x:String x:Key="Text.BranchTree.Remote" xml:space="preserve">リモート<!--REMOTE--></x:String>
  <x:String x:Key="Text.BranchTree.Status" xml:space="preserve">状態<!--STATUS--></x:String>
  <x:String x:Key="Text.BranchTree.Tracking" xml:space="preserve">追跡対象<!--TRACKING--></x:String>
  <x:String x:Key="Text.BranchTree.URL" xml:space="preserve">URL<!--URL--></x:String>
  <x:String x:Key="Text.BranchTree.Worktree" xml:space="preserve">作業ツリー<!--WORKTREE--></x:String>
  <x:String x:Key="Text.Cancel" xml:space="preserve">キャンセル<!--CANCEL--></x:String>
  <x:String x:Key="Text.ChangeCM.CheckoutFirstParentRevision" xml:space="preserve">親リビジョンにリセット<!--Reset to Parent Revision--></x:String>
  <x:String x:Key="Text.ChangeCM.CheckoutThisRevision" xml:space="preserve">このリビジョンにリセット<!--Reset to This Revision--></x:String>
  <x:String x:Key="Text.ChangeCM.GenerateCommitMessage" xml:space="preserve">コミットメッセージを生成<!--Generate commit message--></x:String>
  <x:String x:Key="Text.ChangeCM.Merge" xml:space="preserve">マージ (組み込みツール)<!--Merge (Built-in)--></x:String>
  <x:String x:Key="Text.ChangeCM.MergeExternal" xml:space="preserve">マージ (外部ツール)<!--Merge (External)--></x:String>
  <x:String x:Key="Text.ChangeCM.ResetFileTo" xml:space="preserve">ファイルを ${0}$ にリセット<!--Reset File(s) to ${0}$--></x:String>
  <x:String x:Key="Text.ChangeDisplayMode" xml:space="preserve">表示形式を変更<!--CHANGE DISPLAY MODE--></x:String>
  <x:String x:Key="Text.ChangeDisplayMode.Grid" xml:space="preserve">ファイルとディレクトリの一覧で表示<!--Show as File and Dir List--></x:String>
  <x:String x:Key="Text.ChangeDisplayMode.List" xml:space="preserve">パスの一覧で表示<!--Show as Path List--></x:String>
  <x:String x:Key="Text.ChangeDisplayMode.Tree" xml:space="preserve">ファイルシステムのツリーで表示<!--Show as Filesystem Tree--></x:String>
  <x:String x:Key="Text.ChangeSubmoduleUrl" xml:space="preserve">サブモジュールの URL を変更<!--Change Submodule's URL--></x:String>
  <x:String x:Key="Text.ChangeSubmoduleUrl.Submodule" xml:space="preserve">サブモジュール:<!--Submodule:--></x:String>
  <x:String x:Key="Text.ChangeSubmoduleUrl.URL" xml:space="preserve">URL:<!--URL:--></x:String>
  <x:String x:Key="Text.Checkout" xml:space="preserve">ブランチをチェックアウト<!--Checkout Branch--></x:String>
  <x:String x:Key="Text.Checkout.LocalChanges" xml:space="preserve">ローカルの変更:<!--Local Changes:--></x:String>
  <x:String x:Key="Text.Checkout.Target" xml:space="preserve">ブランチ:<!--Branch:--></x:String>
  <x:String x:Key="Text.Checkout.WarnLostCommits" xml:space="preserve">現在の HEAD には、どのブランチやタグにも繋がっていないコミットが含まれています！それでも続行しますか？<!--Your current HEAD contains commit(s) not connected to any branches/tags! Do you want to continue?--></x:String>
  <x:String x:Key="Text.Checkout.WarnUpdatingSubmodules" xml:space="preserve">これらのサブモジュールを更新する必要があります:{0}更新しますか？<!--The following submodules need to be updated:{0}Do you want to update them?--></x:String>
  <x:String x:Key="Text.Checkout.WithFastForward" xml:space="preserve">チェックアウト &amp; 早送り<!--Checkout & Fast-Forward--></x:String>
  <x:String x:Key="Text.Checkout.WithFastForward.Upstream" xml:space="preserve">早送り先:<!--Fast-Forward to:--></x:String>
  <x:String x:Key="Text.CheckoutBranchFromStash" xml:space="preserve">スタッシュからブランチをチェックアウト<!--Checkout Branch From Stash--></x:String>
  <x:String x:Key="Text.CheckoutBranchFromStash.Branch" xml:space="preserve">新しいブランチ:<!--New Branch:--></x:String>
  <x:String x:Key="Text.CheckoutBranchFromStash.Stash" xml:space="preserve">スタッシュ:<!--Stash:--></x:String>
  <x:String x:Key="Text.CheckoutDetached" xml:space="preserve">コミットまたはタグをチェックアウト<!--Checkout Commit or Tag--></x:String>
  <x:String x:Key="Text.CheckoutDetached.Target" xml:space="preserve">対象:<!--Target:--></x:String>
  <x:String x:Key="Text.CheckoutDetached.Warning" xml:space="preserve">警告: これを行うと、HEAD が切断されます<!--Warning: After doing this, HEAD will be detached--></x:String>
  <x:String x:Key="Text.CherryPick" xml:space="preserve">コミットを取り込む<!--Cherry Pick--></x:String>
  <x:String x:Key="Text.CherryPick.AppendSourceToMessage" xml:space="preserve">取り込み元をコミットメッセージに明記<!--Append source to commit message--></x:String>
  <x:String x:Key="Text.CherryPick.Commit" xml:space="preserve">コミット:<!--Commit(s):--></x:String>
  <x:String x:Key="Text.CherryPick.CommitChanges" xml:space="preserve">すべての変更をコミット<!--Commit all changes--></x:String>
  <x:String x:Key="Text.CherryPick.Mainline" xml:space="preserve">メインライン:<!--Mainline:--></x:String>
  <x:String x:Key="Text.CherryPick.Mainline.Tips" xml:space="preserve">通常、マージコミットを取り込むことはできません。どちらのマージ元をメインラインとして扱うべきかが分からないためです。このオプションを使用すると、指定した親コミットに対して、変更を再適用する形で取り込みを実行できます。<!--Usually you cannot cherry-pick a merge because you do not know which side of the merge should be considered the mainline. This option allows cherry-pick to replay the change relative to the specified parent.--></x:String>
  <x:String x:Key="Text.ClearStashes" xml:space="preserve">スタッシュを消去<!--Clear Stashes--></x:String>
  <x:String x:Key="Text.ClearStashes.Message" xml:space="preserve">すべてのスタッシュを消去します。よろしいですか？<!--You are trying to clear all stashes. Are you sure to continue?--></x:String>
  <x:String x:Key="Text.Clone" xml:space="preserve">リモートリポジトリをクローン<!--Clone Remote Repository--></x:String>
  <x:String x:Key="Text.Clone.AdditionalParam" xml:space="preserve">追加の引数:<!--Extra Parameters:--></x:String>
  <x:String x:Key="Text.Clone.AdditionalParam.Placeholder" xml:space="preserve">リポジトリをクローンする際の追加の引数 (省略可能)<!--Additional arguments to clone repository. Optional.--></x:String>
  <x:String x:Key="Text.Clone.Bookmark" xml:space="preserve">ブックマーク:<!--Bookmark:--></x:String>
  <x:String x:Key="Text.Clone.Group" xml:space="preserve">グループ:<!--Group:--></x:String>
  <x:String x:Key="Text.Clone.LocalName" xml:space="preserve">ローカル名:<!--Local Name:--></x:String>
  <x:String x:Key="Text.Clone.LocalName.Placeholder" xml:space="preserve">リポジトリの名前 (省略可能)<!--Repository name. Optional.--></x:String>
  <x:String x:Key="Text.Clone.ParentFolder" xml:space="preserve">親フォルダー:<!--Parent Folder:--></x:String>
  <x:String x:Key="Text.Clone.RecurseSubmodules" xml:space="preserve">サブモジュールを初期化して更新<!--Initialize & update submodules--></x:String>
  <x:String x:Key="Text.Clone.RemoteURL" xml:space="preserve">リポジトリの URL:<!--Repository URL:--></x:String>
